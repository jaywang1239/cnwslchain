  "seriesDetails": {
    "wsle06": {
      "intro": "WSLE06 / WSLZ06 为威仕龙便携式拖链，内高 10mm，内宽 10–20mm，WSLE 横杆沿外侧打开，WSLZ 沿内侧打开；节距 20mm、50 节/米，可选弯曲半径 R18 / R28 / R38。",
      "material": "PA6+GF30 增强尼龙",
      "openType": "方便型外开",
      "tempRange": "-20℃ ~ 120℃"
    },
    "wsle08": {
      "intro": "WSLE08 / WSLZ08 为威仕龙便携式拖链，内高 15mm，内宽 16–50mm，WSLE 横杆沿外侧打开，WSLZ 沿内侧打开；节距 20mm、50 节/米，可选弯曲半径 R28 / R38 / R48。",
      "material": "PA6+GF30 增强尼龙",
      "openType": "方便型外开",
      "tempRange": "-20℃ ~ 120℃"
    },
    "wsle206": {
      "intro": "WSLE2.06 为威仕龙便携式拖链，内高 10mm，内宽 10–64mm，一体式设计，横杆不可打开；节距 20mm、50 节/米，可选弯曲半径 R18 / R28 / R38。",
      "material": "PA6+GF30 增强尼龙",
      "openType": "一体式",
      "tempRange": "-20℃ ~ 120℃"
    },
    "wsle208": {
      "intro": "WSLE2.08 为威仕龙便携式拖链，内高 15mm，内宽 10–50mm，一体式设计，横杆不可打开；节距 20mm、50 节/米，可选弯曲半径 R25 / R28 / R38 / R48。",
      "material": "PA6+GF30 增强尼龙",
      "openType": "一体式",
      "tempRange": "-20℃ ~ 120℃"
    }
  },
